<Window x:Class="ShopDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ShopDeck.Views"
        Title="ShopDeck 1.2.0 — TEST" Height="820" Width="1280"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- rail vertical -->
        <Border Grid.Column="0" Background="{StaticResource Rail}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,10">
                <!-- outils epingles en bas du rail -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="RailSnip" Style="{StaticResource RailTool}"
                            Tag="âœ‚" Content="Capture"
                            ToolTip="Capture d'Ã©cran (Win+Shift+S)"
                            Click="Snip_Click"/>
                </StackPanel>
                <StackPanel>
                    <RadioButton x:Name="RailDocs" Style="{StaticResource RailButton}"
                                 Tag="ðŸ“š" Content="Docs" IsChecked="True"
                                 Checked="Rail_Checked"/>
                    <RadioButton x:Name="RailProgs" Style="{StaticResource RailButton}"
                                 Tag="âš™" Content="Progs"
                                 Checked="Rail_Checked"/>
                    <RadioButton x:Name="RailFiles" Style="{StaticResource RailButton}"
                                 Tag="ðŸ—‚" Content="Fichiers"
                                 Checked="Rail_Checked"/>
                    <RadioButton x:Name="RailPing" Style="{StaticResource RailButton}"
                                 Tag="ðŸ“¡" Content="Ping"
                                 Checked="Rail_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- zone de contenu: une section visible a la fois, chacune garde ses onglets -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- bandeau MAJ: cache au demarrage, apparait seulement si une release plus recente existe.
                 non-bloquant: le check tourne en tache de fond, offline = rien ne s'affiche -->
            <Border x:Name="UpdateBar" Grid.Row="0" Visibility="Collapsed"
                    Background="#E4ECFB" BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,1">
                <DockPanel Margin="14,8">
                    <Button x:Name="BtnUpdateLater" DockPanel.Dock="Right" Content="Plus tard"
                            Padding="10,4" Margin="6,0,0,0" Click="UpdateLater_Click"
                            Background="Transparent" BorderBrush="{StaticResource Border}"/>
                    <Button x:Name="BtnUpdateNow" DockPanel.Dock="Right" Content="Mettre a jour"
                            Padding="12,4" Click="UpdateNow_Click"
                            Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"/>
                    <TextBlock x:Name="UpdateText" VerticalAlignment="Center" Foreground="{StaticResource Text}"
                               Text="Une nouvelle version est disponible."/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <v:DocumentationView x:Name="ViewDocs"/>
                <v:ProgramsView x:Name="ViewProgs" Visibility="Collapsed"/>
                <v:FilesView x:Name="ViewFiles" Visibility="Collapsed"/>
                <v:PingView x:Name="ViewPing" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</Window>

