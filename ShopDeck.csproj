<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ShopDeck</AssemblyName>
    <Product>ShopDeck</Product>
    <Company>Julien Forget</Company>
    <AssemblyTitle>ShopDeck</AssemblyTitle>
    <!-- version comparee au tag de la derniere GitHub Release pour l'auto-update -->
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <RootNamespace>ShopDeck</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>793f.ico</ApplicationIcon>
    <!-- self-contained: rien a installer sur les PC compagnie -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- DOSSIER par defaut (depuis 1.4.0). Le single-file non signe etait rescanne par l'EDR a chaque
         chargement de DLL -> 10 min de boot sur PC compagnie. En dossier : DLL signees Microsoft, zero extraction.
         `dotnet publish -p:SingleFileBridge=true` produit encore l'exe unique = asset PONT pour les clients <=1.3.5. -->
    <SingleFileBridge Condition="'$(SingleFileBridge)' == ''">false</SingleFileBridge>
    <PublishSingleFile>$(SingleFileBridge)</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>$(SingleFileBridge)</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>$(SingleFileBridge)</EnableCompressionInSingleFile>
    <!-- pre-JIT: moins de compilation au boot, DLL un peu plus grosses -->
    <PublishReadyToRun Condition="'$(SingleFileBridge)' != 'true'">true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- les index de la flotte voyagent avec l'exe (dossier data a cote du binaire) -->
  <ItemGroup>
    <Content Include="..\data\equipment_fleet.json" Link="data\equipment_fleet.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\data\schematics_index.json" Link="data\schematics_index.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

